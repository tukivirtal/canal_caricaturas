PORT=5000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=caricaturas

# Necesaria para que el servicio sintetice las voces por su cuenta en vez
# de que lo haga Make (que cobra 3-4 operaciones por cada linea de
# dialogo). Sin esta variable, las lineas tienen que llegar con
# 'audio_url' ya resuelto, como antes.
ELEVENLABS_API_KEY=
ELEVENLABS_MODELO=eleven_multilingual_v2
